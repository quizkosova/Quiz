<!DOCTYPE html>
<html lang="sq">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ArtiQuiz</title>

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: linear-gradient(135deg, #111827, #2563eb);
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .quiz {
        width: 100%;
        max-width: 650px;
        background: white;
        padding: 30px;
        border-radius: 22px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    }

    .logo {
        text-align: center;
        font-size: 34px;
        font-weight: bold;
        margin-bottom: 10px;
    }

    .top {
        display: flex;
        justify-content: space-between;
        font-weight: bold;
        margin-bottom: 12px;
    }

    .progress-bg {
        width: 100%;
        height: 10px;
        background: #ddd;
        border-radius: 10px;
        overflow: hidden;
        margin-bottom: 25px;
    }

    .progress {
        height: 100%;
        width: 0%;
        background: #2563eb;
        transition: 0.3s;
    }

    .timer {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        margin-bottom: 15px;
    }

    #pyetja {
        text-align: center;
        font-size: 25px;
        margin-bottom: 25px;
    }

    .answers button {
        width: 100%;
        padding: 15px;
        margin: 8px 0;
        border: 2px solid #ddd;
        border-radius: 12px;
        background: white;
        font-size: 17px;
        cursor: pointer;
        transition: 0.2s;
    }

    .answers button:hover {
        background: #eef4ff;
        border-color: #2563eb;
    }

    .correct {
        background: #22c55e !important;
        color: white;
        border-color: #22c55e !important;
    }

    .wrong {
        background: #ef4444 !important;
        color: white;
        border-color: #ef4444 !important;
    }

    #mesazhi {
        text-align: center;
        font-size: 20px;
        font-weight: bold;
        min-height: 30px;
        margin-top: 15px;
    }

    .score {
        text-align: center;
        font-weight: bold;
        margin-top: 15px;
    }

    .final {
        text-align: center;
    }

    .final h1 {
        font-size: 38px;
    }

    .final h2 {
        font-size: 30px;
    }

    .restart {
        background: #2563eb;
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 12px;
        font-size: 18px;
        cursor: pointer;
        margin-top: 15px;
    }
</style>
</head>

<body>

<div class="quiz" id="quiz">

    <div class="logo">🧠 ArtiQuiz</div>

    <div class="top">
        <span id="numri">Pyetja 1/15</span>
        <span id="piket">Pikët: 0</span>
    </div>

    <div class="progress-bg">
        <div class="progress" id="progress"></div>
    </div>

    <div class="timer">
        ⏱️ Koha: <span id="koha">15</span>s
    </div>

    <h2 id="pyetja"></h2>

    <div class="answers">
        <button onclick="kontrollo(0)" id="a"></button>
        <button onclick="kontrollo(1)" id="b"></button>
        <button onclick="kontrollo(2)" id="c"></button>
        <button onclick="kontrollo(3)" id="d"></button>
    </div>

    <div id="mesazhi"></div>

    <div class="score">
        Rekordi: <span id="rekordi">0</span>
    </div>

</div>

<script>

const pytet = [
    {
        pyetja: "Cili është kryeqyteti i Kosovës?",
        pergjigje: ["Prishtina", "Peja", "Prizreni", "Gjakova"],
        sakte: 0
    },
    {
        pyetja: "Sa është 5 + 7?",
        pergjigje: ["10", "11", "12", "13"],
        sakte: 2
    },
    {
        pyetja: "Cili planet njihet si Planeti i Kuq?",
        pergjigje: ["Toka", "Marsi", "Jupiteri", "Venusi"],
        sakte: 1
    },
    {
        pyetja: "Sa kontinente ka Toka?",
        pergjigje: ["5", "6", "7", "8"],
        sakte: 2
    },
    {
        pyetja: "Cili është oqeani më i madh?",
        pergjigje: ["Atlantiku", "Indian", "Arktiku", "Paqësori"],
        sakte: 3
    },
    {
        pyetja: "Sa ditë ka një javë?",
        pergjigje: ["5", "6", "7", "8"],
        sakte: 2
    },
    {
        pyetja: "Cili është simboli kimik i ujit?",
        pergjigje: ["CO2", "H2O", "O2", "NaCl"],
        sakte: 1
    },
    {
        pyetja: "Cili është planeti më i madh në Sistemin Diellor?",
        pergjigje: ["Toka", "Saturni", "Jupiteri", "Marsi"],
        sakte: 2
    },
    {
        pyetja: "Sa është 10 × 10?",
        pergjigje: ["10", "50", "100", "1000"],
        sakte: 2
    },
    {
        pyetja: "Cila gjuhë përdoret për strukturën e faqeve web?",
        pergjigje: ["HTML", "Python", "SQL", "Excel"],
        sakte: 0
    },
    {
        pyetja: "Cili është sateliti natyror i Tokës?",
        pergjigje: ["Dielli", "Hëna", "Marsi", "Venusi"],
        sakte: 1
    },
    {
        pyetja: "Sa muaj ka një vit?",
        pergjigje: ["10", "11", "12", "13"],
        sakte: 2
    },
    {
        pyetja: "Cili është kryeqyteti i Shqipërisë?",
        pergjigje: ["Durrësi", "Tirana", "Vlora", "Shkodra"],
        sakte: 1
    },
    {
        pyetja: "Sa është 100 ÷ 4?",
        pergjigje: ["20", "25", "30", "40"],
        sakte: 1
    },
    {
        pyetja: "Cili prej këtyre është gjuhë programimi?",
        pergjigje: ["Python", "Chrome", "Windows", "YouTube"],
        sakte: 0
    }
];

let numri = 0;
let pike = 0;
let koha = 15;
let timer;

let rekordi = localStorage.getItem("artiRekordi") || 0;
document.getElementById("rekordi").innerText = rekordi;

function shfaqPyetjen() {

    clearInterval(timer);

    koha = 15;
    document.getElementById("koha").innerText = koha;

    document.getElementById("numri").innerText =
        "Pyetja " + (numri + 1) + "/15";

    document.getElementById("piket").innerText =
        "Pikët: " + pike;

    document.getElementById("pyetja").innerText =
        pytet[numri].pyetja;

    document.getElementById("a").innerText =
        pytet[numri].pergjigje[0];

    document.getElementById("b").innerText =
        pytet[numri].pergjigje[1];

    document.getElementById("c").innerText =
        pytet[numri].pergjigje[2];

    document.getElementById("d").innerText =
        pytet[numri].pergjigje[3];

    document.getElementById("mesazhi").innerText = "";

    document.getElementById("progress").style.width =
        ((numri + 1) / pytet.length * 100) + "%";

    document.querySelectorAll(".answers button").forEach(btn => {
        btn.disabled = false;
        btn.classList.remove("correct", "wrong");
    });

    timer = setInterval(() => {

        koha--;

        document.getElementById("koha").innerText = koha;

        if (koha <= 0) {
            clearInterval(timer);
            kohaMbaroi();
        }

    }, 1000);
}

function kontrollo(zgjedhja) {

    clearInterval(timer);

    const butonat =
        document.querySelectorAll(".answers button");

    butonat.forEach(btn => btn.disabled = true);

    if (zgjedhja === pytet[numri].sakte) {

        pike++;

        butonat[zgjedhja].classList.add("correct");

        document.getElementById("mesazhi").innerText =
            "Saktë! ✅";

    } else {

        butonat[zgjedhja].classList.add("wrong");

        butonat[pytet[numri].sakte].classList.add("correct");

        document.getElementById("mesazhi").innerText =
            "Gabim! ❌";
    }

    document.getElementById("piket").innerText =
        "Pikët: " + pike;

    setTimeout(() => {

        numri++;

        if (numri < pytet.length) {
            shfaqPyetjen();
        } else {
            perfundo();
        }

    }, 1000);
}

function kohaMbaroi() {

    const butonat =
        document.querySelectorAll(".answers button");

    butonat.forEach(btn => btn.disabled = true);

    butonat[pytet[numri].sakte].classList.add("correct");

    document.getElementById("mesazhi").innerText =
        "Koha mbaroi! ⏰";

    setTimeout(() => {

        numri++;

        if (numri < pytet.length) {
            shfaqPyetjen();
        } else {
            perfundo();
        }

    }, 1000);
}

function perfundo() {

    clearInterval(timer);

    let perqindja =
        Math.round((pike / pytet.length) * 100);

    if (pike > rekordi) {
        rekordi = pike;
        localStorage.setItem("artiRekordi", rekordi);
    }

    document.getElementById("quiz").innerHTML = `
        <div class="final">
            <h1>🎉 Përfundoi!</h1>

            <h2>${pike}/15</h2>

            <p>Rezultati: ${perqindja}%</p>

            <p>🥇 Rekordi: ${rekordi}/15</p>

            <button class="restart" onclick="location.reload()">
                🔄 Luaj përsëri
            </button>
        </div>
    `;
}

shfaqPyetjen();

</script>

</body>
</html>
